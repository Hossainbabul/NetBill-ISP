# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# APP_URL is ALSO the base of the payment links sent to customers by SMS, e.g. APP_URL="https://pay.yourisp.com"
APP_URL="MY_APP_URL"

# SMS Gateway Configuration (Server-Side Only - Never expose keys to frontend)
# SMS_PROVIDER: "twilio" | "local_bd" | "sandbox"
SMS_PROVIDER="sandbox"

# Twilio Credentials (required when SMS_PROVIDER="twilio")
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Local BD / HTTP SMS API (e.g., BulkSMSBD, SSL Wireless, GreenWeb)
LOCAL_SMS_API_URL="https://bulksmsbd.net/api/smsapi"
LOCAL_SMS_API_KEY=""
LOCAL_SMS_SENDER_ID="NetBillISP"

# ───────── Security settings ─────────
# ADMIN_PASSWORD: optional. If set (8+ chars), used as the admin password on first start.
# If empty, a random password is generated and printed ONCE in the server console.
ADMIN_PASSWORD=""
# RESET_ADMIN_PASSWORD: set to 1 together with ADMIN_PASSWORD to reset a forgotten admin password
# at the next start (then remove it again).
RESET_ADMIN_PASSWORD=""
# SESSION_IDLE_HOURS: log users out after this many hours of inactivity (default 12)
SESSION_IDLE_HOURS="12"
# Behind Nginx / Caddy / Cloud Run: set TRUST_PROXY=1 so rate-limits use the real client IP.
# Leave empty if the app is exposed directly to the internet.
TRUST_PROXY=""
# FORCE_HTTPS=1 redirects http→https (needs TRUST_PROXY and production mode: npm run serve)
FORCE_HTTPS=""
# BLOCK_FRAMING=1 stops other sites from embedding the app (leave empty while using AI Studio preview)
BLOCK_FRAMING=""

